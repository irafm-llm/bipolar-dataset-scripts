{
 "dataset": "MIRROR-EN-UA-RU",
 "version": "1.2",
 "encoding": "UTF-8 (no BOM)",
 "delimiter": ",",
 "columns": [
  {
   "file": "category files (<id>-<category>.csv)",
   "column": "pair_id",
   "type": "string",
   "allowed_values": "<prefix>_<001-100>, prefix is category-specific (e.g. ms = Make Statement)",
   "description": "Identifier of the scenario template; the 12 rows sharing a pair_id form one minimal-pair set"
  },
  {
   "file": "category files (<id>-<category>.csv)",
   "column": "category",
   "type": "string",
   "allowed_values": "one of 22 category labels",
   "description": "Event category label; identical in all rows of a file and consistent with the file name"
  },
  {
   "file": "category files (<id>-<category>.csv)",
   "column": "entity_type",
   "type": "string",
   "allowed_values": "see entity_inventory.csv",
   "description": "Role of the actor; constant within a pair_id"
  },
  {
   "file": "category files (<id>-<category>.csv)",
   "column": "timeframe",
   "type": "enum",
   "allowed_values": "Past | Present | Future",
   "description": "Temporal frame; realised by a set of openers and the corresponding verb form"
  },
  {
   "file": "category files (<id>-<category>.csv)",
   "column": "side",
   "type": "enum",
   "allowed_values": "ua | ru",
   "description": "Nationality of the actor (ua = Ukrainian; ru = Russian)"
  },
  {
   "file": "category files (<id>-<category>.csv)",
   "column": "sentiment",
   "type": "enum",
   "allowed_values": "pos | neg",
   "description": "Valence of the actor's conduct within the event type (pos = constructive/lawful/harm-minimising, including lawful responses to Mass Violence; neg = harmful/abusive or constructive action withheld)"
  },
  {
   "file": "category files (<id>-<category>.csv)",
   "column": "sentence_en",
   "type": "string",
   "allowed_values": "free text",
   "description": "English sentence generated by GPT-5.4 and editorially corrected"
  },
  {
   "file": "category files (<id>-<category>.csv)",
   "column": "ru",
   "type": "string",
   "allowed_values": "free text (Cyrillic)",
   "description": "Russian mirror translation of sentence_en"
  },
  {
   "file": "category files (<id>-<category>.csv)",
   "column": "uk",
   "type": "string",
   "allowed_values": "free text (Cyrillic)",
   "description": "Ukrainian mirror translation of sentence_en"
  },
  {
   "file": "entity_inventory.csv",
   "column": "category",
   "type": "string",
   "allowed_values": "one of 22 category labels",
   "description": "Category in which the entity type is used"
  },
  {
   "file": "entity_inventory.csv",
   "column": "entity",
   "type": "string",
   "allowed_values": "free text",
   "description": "Entity type (actor role) used in that category"
  },
  {
   "file": "templates.csv",
   "column": "file",
   "type": "string",
   "allowed_values": "file name",
   "description": "Category file the template comes from"
  },
  {
   "file": "templates.csv",
   "column": "category",
   "type": "string",
   "allowed_values": "one of 22 category labels",
   "description": "Category label"
  },
  {
   "file": "templates.csv",
   "column": "pair_id",
   "type": "string",
   "allowed_values": "as above",
   "description": "Template identifier"
  },
  {
   "file": "templates.csv",
   "column": "entity_type",
   "type": "string",
   "allowed_values": "as above",
   "description": "Entity type instantiated in this template"
  },
  {
   "file": "templates.csv",
   "column": "pos_past | pos_present | pos_future",
   "type": "string",
   "allowed_values": "frame with slots {TIME} {SIDE_ADJ} {ENTITY}",
   "description": "Positive sentence frame per timeframe"
  },
  {
   "file": "templates.csv",
   "column": "neg_past | neg_present | neg_future",
   "type": "string",
   "allowed_values": "frame with slots {TIME} {SIDE_ADJ} {ENTITY}",
   "description": "Negative sentence frame per timeframe"
  },
  {
   "file": "templates.csv",
   "column": "opener_past | opener_present | opener_future",
   "type": "string",
   "allowed_values": "temporal opener text",
   "description": "Concrete opener used for the timeframe in this template"
  },
  {
   "file": "templates.csv",
   "column": "consistent",
   "type": "enum",
   "allowed_values": "yes | no",
   "description": "yes if the ua and ru variants of every cell collapse to the same frame (perfect minimal pair)"
  },
  {
   "file": "templates.csv",
   "column": "scenario_id",
   "type": "string",
   "allowed_values": "<prefix>_s<NNN>",
   "description": "Identifier shared by templates with identical frames (same scenario instantiated with different entity types/openers)"
  },
  {
   "file": "templates.csv",
   "column": "scenario_instances",
   "type": "integer",
   "allowed_values": "1-5",
   "description": "Number of pair_ids sharing the scenario_id"
  }
 ]
}
